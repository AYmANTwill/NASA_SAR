{
  "name": "nisar-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "node scripts/generate-data.mjs && node scripts/index-media.mjs",
    "lint": "eslint .",
    "format": "prettier --write src docs scripts",
    "test:data": "node scripts/validate-data.mjs",
    "test:browser": "node scripts/browser-check.mjs && node scripts/interaction-check.mjs",
    "predev": "node scripts/index-media.mjs",
    "prebuild": "node scripts/index-media.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0"
  }
