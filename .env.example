# http (default): talk to the FastAPI backend at VITE_API_BASE (same-origin /api; Vite proxies it to VITE_API_PROXY in dev).
# fixtures: serve synthetic data from src/__fixtures__ (a "test data" banner is always shown).
VITE_API_MODE=http
VITE_API_BASE=/api
# Dev proxy target for /api (read by vite.config.ts)
VITE_API_PROXY=http://127.0.0.1:8000
